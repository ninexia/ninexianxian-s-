{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/report-docx/template.schema.json",
  "title": "Report template",
  "type": "object",
  "required": ["id", "name", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "priority": { "type": "integer", "default": 0 },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "default": {}
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "enum": ["A4", "Letter"] },
        "orientation": { "enum": ["portrait", "landscape"] },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" },
            "right": { "type": "number" }
          }
        },
        "headerDistance": { "type": "number" },
        "footerDistance": { "type": "number" }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "latin": { "type": "string" },
          "eastAsia": { "type": "string" },
          "size": { "type": "number" },
          "bold": { "type": "boolean" },
          "lineSpacing": { "type": "number" },
          "spaceBefore": { "type": "number" },
          "spaceAfter": { "type": "number" },
          "align": { "enum": ["left", "center", "right", "justify"] },
          "firstLineIndent": { "type": "number" },
          "keepWithNext": { "type": "boolean" }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "fields"],
      "properties": {
        "enabled": { "type": "boolean" },
        "layout": { "enum": ["center", "table"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean", "default": false },
              "default": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "pageNumber": { "type": "boolean" }
      }
    },
    "toc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minSections": { "type": "integer" },
        "title": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
          "title": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 3 },
          "kind": { "enum": ["paragraphs", "list", "table", "task-group", "mixed"] },
          "required": { "type": "boolean" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "hint": { "type": "string" },
          "minWords": { "type": "integer" },
          "maxWords": { "type": "integer" },
          "taskPatterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
