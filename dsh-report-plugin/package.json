{
  "name": "@local/dsh-report-docx",
  "version": "0.2.0",
  "private": true,
  "description": "Markdown template-driven DOCX experiment report generator for DeepSeek Harness (no Python dependency)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./templates/*.md": "./templates/*.md",
    "./templates/*.json": "./templates/*.json"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "templates/*.md",
    "templates/*.json",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "config.schema.json",
    "README.md",
    "DESIGN.md",
    "tests/*.mjs",
    "tests/fixtures/*"
  ],
  "dependencies": {
    "docx": "^8.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
